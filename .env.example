GROQ_API_KEY=

TIER_FREE_MODEL=groq/llama-3.1-8b-instant
TIER_PREMIUM_MODEL=groq/llama-3.3-70b-versatile
EFFICIENCY_MODE_MODEL=groq/llama-3.1-8b-instant
TIER_FREE_MAX_HISTORY_TURNS=1
TIER_PREMIUM_MAX_HISTORY_TURNS=3

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SABI_DEMO_MODE=true
SABI_BOOTSTRAP_MOCK_DATA=true

SYMPY_TIMEOUT_MS=250
SYMPY_MAX_WORKERS=1

LLM_TIMEOUT_SECONDS=2.5
LLM_QUEUE_TIMEOUT_SECONDS=0.05
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_MIN_SECONDS=0.05
LLM_RETRY_MAX_SECONDS=0.2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=20.0

REQUEST_ADMISSION_MAX_CONCURRENT=24
REQUEST_ADMISSION_QUEUE_TIMEOUT_SECONDS=0.01

OBSERVABILITY_TRACE_BUFFER_SIZE=1000
OBSERVABILITY_TRACE_FLUSH_ENABLED=true
OBSERVABILITY_TRACE_FLUSH_INTERVAL_SECONDS=1.0
OBSERVABILITY_TRACE_FLUSH_BATCH_SIZE=100
OBSERVABILITY_TRACE_LOG_PATH=logs/sabipass_traces.jsonl
